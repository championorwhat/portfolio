# Copy to .env.local for `npm run dev`, and set the same variables in your host
# (Vercel -> Project -> Settings -> Environment Variables).
# NEVER commit a real key, and never prefix it with VITE_ (that would ship it to the browser).
#
# 100% free setup (no credit card): create a key at https://console.groq.com/keys
LLM_API_KEY=gsk_...

# optional - these defaults already point at Groq's free tier
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# Other free providers (any OpenAI-compatible endpoint works):
#   Google Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
#   OpenRouter    : LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a model whose id ends in :free>
#
# CHAT_LIMIT_PER_IP=15      # questions per visitor per day
# CHAT_LIMIT_GLOBAL=250     # questions for the whole site per day (keeps you inside the free quota)
# ALLOWED_ORIGIN=https://yourname.dev
